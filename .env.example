# Copy this file to ".env" for local work. On Render, set the same names in
# Dashboard → your service → Environment. NEVER commit a real .env file.

# Postgres connection string (Render: Postgres → "Internal Database URL")
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign login cookies. At least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account (created only if no working admin exists yet).
# Password: at least 10 characters. You will be asked to change it at first login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- optional ---
# DATABASE_SSL=disable      # force SSL off (rarely needed). "require" forces it on.
# DISABLE_CSP=1             # emergency switch: turns off the Content-Security-Policy header
# ENABLE_GROK_EXTENSIONS=1  # load the third-party "Created with Grok" script (off by default)
